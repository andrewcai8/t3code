{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "lib": ["ESNext", "esnext.disposable"]
  },
  // The cloud deploy planner resolves host credential paths with the server's
  // own resolver so the two cannot drift; the file has no dependencies.
  "include": ["**/*.ts", "../apps/server/src/provider/cursorCredentialPath.ts"]
}
