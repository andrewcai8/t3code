{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "lib": ["ESNext", "esnext.disposable", "DOM"]
  },
  // The cloud deploy scripts share the server's credential paths and copy
  // transforms so the two cannot drift; these files have no dependencies.
  "include": [
    "**/*.ts",
    "../apps/server/src/environmentControl/credentialDestinations.ts",
    "../apps/server/src/provider/codexLoginCopy.ts",
    "../apps/server/src/provider/providerCredentialName.ts",
    // The cloud smoke's turn fold tests against the client's V2 projection fixtures.
    "../packages/client-runtime/src/state/orchestrationV2TestFixtures.ts"
  ]
}
